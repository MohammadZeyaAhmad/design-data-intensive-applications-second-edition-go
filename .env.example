# Use make configure to create .env with random credentials. These placeholders
# are deliberately not sufficient to start the application.
POSTGRES_PASSWORD=replace-with-generated-value
ATLAS_DATABASE_URL=postgresql://atlas:replace-with-generated-value@127.0.0.1:15433/atlas_dev?sslmode=disable
ATLAS_TEST_DATABASE_URL=postgresql://atlas:replace-with-generated-value@127.0.0.1:15433/atlas_test?sslmode=disable
ATLAS_TENANT_KEYS=acme=replace-with-generated-value,globex=replace-with-another-generated-value
ATLAS_HTTP_ADDR=127.0.0.1:18081
# Inventory HTTP authoritative reads only. Generate a separate 32+ byte key.
ATLAS_READ_ROUTING_ENABLED=false
ATLAS_READ_TOKEN_KEY=
ATLAS_READ_REPLICAS={}
ATLAS_BASE_URL=http://127.0.0.1:18081

ATLAS_PROVIDER_TOKEN=replace-with-generated-provider-token
ATLAS_PROVIDER_URL=http://127.0.0.1:18082

# Optional isolated search/pgvector application profile.
ATLAS_SEARCH_VECTOR_ENABLED=false

# Optional graph lab: make configure generates this secret in ignored .env.
# ATLAS_GRAPH_PASSWORD is appended by make configure.

# make configure also appends a persistent random ATLAS_GRAPHQL_CURSOR_KEY.

# Optional display cache; authoritative product reads and quotes use PostgreSQL.
ATLAS_CACHE_BACKEND=memory
# The Redis profile sets redis:6379 inside the API container.
# ATLAS_CACHE_ADDRESS=127.0.0.1:16379
ATLAS_CACHE_REFRESH_AHEAD=false
ATLAS_CACHE_WRITE_THROUGH=false
# Read and write workloads each have independent admission/rate budgets.
ATLAS_HTTP_READ_ACTIVE=16
ATLAS_HTTP_READ_QUEUED=32
ATLAS_HTTP_WRITE_ACTIVE=16
ATLAS_HTTP_WRITE_QUEUED=32
ATLAS_HTTP_RATE=2000
ATLAS_HTTP_BURST=512

# Optional observation profile. make configure appends a separate reader key.
ATLAS_TELEMETRY_ENABLED=false
ATLAS_DURABLE_TRACE=false
# Set only after every consumer supports the expanded metadata contract.
# ATLAS_OTLP_ENDPOINT=http://127.0.0.1:19418/v1/traces
# ATLAS_METRICS_ADDR=127.0.0.1:19181
ATLAS_TRACE_SAMPLE=1
