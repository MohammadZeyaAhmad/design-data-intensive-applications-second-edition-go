{
  "openapi": "3.1.0",
  "info": {
    "title": "Atlas Inventory REST contract",
    "version": "1.3.0",
    "description": "Executable reservation/stock subset. Other Atlas routes have their own context contracts. JSON integers are emitted as numbers; use an exact integer decoder. The gRPC contract uses protobuf int64 and millisecond expiry timestamps. Opt-in Inventory HTTP session consistency: signed tenant/source/history WAL watermarks bound future reads, not exact snapshot identity. See docs/SESSION_CONSISTENCY.md. Commands stay on the primary; asynchronous projection and other context/transport routes do not implement this contract."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18081"
    }
  ],
  "security": [
    {
      "DevelopmentTenantBearer": []
    }
  ],
  "paths": {
