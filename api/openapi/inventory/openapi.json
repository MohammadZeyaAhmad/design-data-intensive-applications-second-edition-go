    "/v1/inventory/snapshot": {
      "get": {
        "operationId": "getInventorySnapshot",
        "description": "Stock and matching reservation from one read-only repeatable-read transaction on one selected endpoint. Both belong to the authenticated tenant and requested SKU/warehouse. Requires opt-in session routing.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Timeout"
          },
          {
            "in": "query",
            "name": "sku",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "reservation_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/Warehouse"
          },
          {
            "$ref": "#/components/parameters/SessionToken"
          },
          {
            "$ref": "#/components/parameters/ReadConsistency"
          },
          {
            "$ref": "#/components/parameters/ReadOnLag"
          },
          {
            "$ref": "#/components/parameters/ReadWait"
          }
        ],
        "responses": {
          "200": {
            "description": "Coherent stock/reservation view",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventorySnapshot"
                }
              }
            },
            "headers": {
              "X-Session-Token": {
                "$ref": "#/components/headers/XSessionToken"
              },
              "X-Session-Status": {
                "$ref": "#/components/headers/XSessionStatus"
              },
              "X-Read-Source": {
                "$ref": "#/components/headers/XReadSource"
              },
              "X-Read-Reason": {
                "$ref": "#/components/headers/XReadReason"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported fields, metadata or budget; Invalid input/token or unsupported consistency contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid tenant bearer key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource not visible to this tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Session-Token": {
                "$ref": "#/components/headers/XSessionToken"
              },
              "X-Session-Status": {
                "$ref": "#/components/headers/XSessionStatus"
              },
              "X-Read-Source": {
                "$ref": "#/components/headers/XReadSource"
              },
              "X-Read-Reason": {
                "$ref": "#/components/headers/XReadReason"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            }
          },
          "408": {
            "description": "Request canceled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Insufficient stock or conflicting command identity; Business conflict or session source/history changed; reconcile before beginning another session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal operation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Capacity exhausted, draining or not ready; Read authority or snapshot endpoint unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Suggested delay in seconds; retain the same command identity when retrying",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "504": {
            "description": "Deadline exceeded; outcome can be uncertain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the finite 64 KiB admission bound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Workload token bucket exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Suggested delay in seconds; retain the same command identity when retrying",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "410": {
            "description": "Session token expired; explicitly begin a new session with a primary read",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "425": {
            "description": "Replica did not reach the recorded session fence. No stale success or advanced token is returned. Retry or explicitly choose primary fallback.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 1
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DevelopmentTenantBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Local development tenant key; server chooses the tenant."
      }
    },
    "parameters": {
      "Timeout": {
        "name": "X-Request-Timeout-Ms",
        "in": "header",
        "required": false,
        "description": "Optional ingress budget, 1..10000 ms. An earlier parent deadline wins. A timeout may follow commit.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Stable command identity scoped to authenticated tenant and operation. Reuse exactly the same command after an uncertain result.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        }
      },
      "SKU": {
        "name": "sku",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      },
      "ReservationID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Warehouse": {
        "name": "warehouse_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9-]{0,63})?$",
          "default": ""
        }
      },
      "SessionToken": {
        "in": "header",
        "name": "X-Session-Token",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 4096
        },
        "description": "Opaque signed session fence. Forward the latest token on subsequent operations; wrong tenant/history is rejected."
      },
      "ReadConsistency": {
        "in": "header",
        "name": "X-Read-Consistency",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "primary",
            "replica"
          ],
          "default": "primary"
        },
        "description": "Authoritative primary or physical-replica read. Enabled only with ATLAS_READ_ROUTING_ENABLED=true."
      },
      "ReadOnLag": {
        "in": "header",
        "name": "X-Read-On-Lag",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "pending",
            "primary"
          ],
          "default": "pending"
        },
        "description": "A replica that cannot meet the session fence returns 425 or explicit primary fallback."
      },
      "ReadWait": {
        "in": "header",
        "name": "X-Read-Wait-Ms",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "default": 100
        },
        "description": "Total replay-wait budget in milliseconds. Zero allows one bounded probe per configured endpoint, without intentional retry."
      }
    },
    "schemas": {
      "ReserveRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "ttl_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 3600,
            "default": 0
          },
          "warehouse_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([a-z][a-z0-9-]{0,63})?$",
            "default": ""
          }
        },
        "required": [
          "sku",
          "quantity"
        ]
      },
      "ReceiveRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "warehouse_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([a-z][a-z0-9-]{0,63})?$",
            "default": ""
          }
        },
        "required": [
          "quantity"
        ]
      },
      "Stock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "on_hand": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "reserved": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "allocated": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "warehouse_id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9-]{0,63})?$",
            "default": ""
          }
        },
        "required": [
          "tenant_id",
          "sku",
          "on_hand",
          "reserved",
          "allocated",
          "version"
        ]
      },
      "Reservation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "committed",
              "released",
              "reversed",
              "expired",
              "shipped"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "warehouse_id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9-]{0,63})?$",
            "default": ""
          }
        },
        "required": [
          "id",
          "tenant_id",
          "sku",
          "quantity",
          "status",
          "version",
          "expires_at"
        ]
      },
      "ReserveOutcome": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stock": {
            "$ref": "#/components/schemas/Stock"
          },
          "reservation": {
            "$ref": "#/components/schemas/Reservation"
          }
        },
        "required": [
          "stock",
          "reservation"
        ]
      },
      "ReceiveOutcome": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stock": {
            "$ref": "#/components/schemas/Stock"
          }
        },
        "required": [
          "stock"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "InventorySnapshot": {
        "type": "object",
        "required": [
          "stock",
          "reservation"
        ],
        "properties": {
          "stock": {
            "$ref": "#/components/schemas/Stock"
          },
          "reservation": {
            "$ref": "#/components/schemas/Reservation"
          }
        },
        "additionalProperties": false
      }
    },
    "headers": {
      "XSessionToken": {
        "schema": {
          "type": "string",
          "maxLength": 4096
        },
        "description": "Signed future-read watermark when X-Session-Status=issued. May include commits beyond this response snapshot."
      },
      "XSessionStatus": {
        "schema": {
          "type": "string",
          "enum": [
            "issued",
            "unavailable"
          ]
        },
        "description": "A committed command remains successful if fence capture fails. unavailable requires a primary read before resuming session replica reads."
      },
      "XReadSource": {
        "schema": {
          "type": "string"
        },
        "description": "Server-owned primary or replica label; no connection details."
      },
      "XReadReason": {
        "schema": {
          "type": "string"
        },
        "description": "requested-primary, replica-ready, replica-timeout-primary or committed-write."
      },
      "CacheControl": {
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      }
    }
  }
}
