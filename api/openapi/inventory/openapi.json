            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/SessionToken"
          }
        ],
        "responses": {
          "201": {
            "description": "Saved command outcome; inspect Idempotent-Replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReserveOutcome"
                }
              }
            },
            "headers": {
              "Idempotent-Replay": {
                "schema": {
                  "type": "boolean"
                },
                "description": "true returns the original saved response"
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Stock revision, informational; conditional commands are rejected"
              },
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Reservation resource URI"
              },
              "X-Session-Token": {
                "$ref": "#/components/headers/XSessionToken"
              },
              "X-Session-Status": {
                "$ref": "#/components/headers/XSessionStatus"
              },
              "X-Read-Source": {
                "$ref": "#/components/headers/XReadSource"
              },
              "X-Read-Reason": {
                "$ref": "#/components/headers/XReadReason"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported fields, metadata or budget; Invalid input/token or unsupported consistency contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Invalid tenant bearer key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource not visible to this tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "X-Session-Token": {
                "$ref": "#/components/headers/XSessionToken"
              },
              "X-Session-Status": {
                "$ref": "#/components/headers/XSessionStatus"
              },
              "X-Read-Source": {
                "$ref": "#/components/headers/XReadSource"
              },
              "X-Read-Reason": {
                "$ref": "#/components/headers/XReadReason"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              }
            }
          },
          "408": {
            "description": "Request canceled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Insufficient stock or conflicting command identity; Business conflict or session source/history changed; reconcile before beginning another session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal operation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Capacity exhausted, draining or not ready; Read authority or snapshot endpoint unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Suggested delay in seconds; retain the same command identity when retrying",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "504": {
            "description": "Deadline exceeded; outcome can be uncertain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the finite 64 KiB admission bound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
