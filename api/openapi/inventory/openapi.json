    },
    "/healthz": {
      "get": {
        "operationId": "liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Database and migrations ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DevelopmentTenantBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Local development tenant key; server chooses the tenant."
      }
    },
    "parameters": {
      "Timeout": {
        "name": "X-Request-Timeout-Ms",
        "in": "header",
        "required": false,
        "description": "Optional ingress budget, 1..10000 ms. An earlier parent deadline wins. A timeout may follow commit.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Stable command identity scoped to authenticated tenant and operation. Reuse exactly the same command after an uncertain result.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        }
      },
      "SKU": {
        "name": "sku",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      },
      "ReservationID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Warehouse": {
        "name": "warehouse_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9-]{0,63})?$",
          "default": ""
        }
      }
    },
    "schemas": {
      "ReserveRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "ttl_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 3600,
            "default": 0
          },
          "warehouse_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([a-z][a-z0-9-]{0,63})?$",
            "default": ""
          }
        },
        "required": [
          "sku",
          "quantity"
        ]
      },
      "ReceiveRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "warehouse_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([a-z][a-z0-9-]{0,63})?$",
            "default": ""
          }
        },
        "required": [
          "quantity"
        ]
      },
      "Stock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "on_hand": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "reserved": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "allocated": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "warehouse_id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9-]{0,63})?$",
            "default": ""
          }
        },
        "required": [
          "tenant_id",
          "sku",
          "on_hand",
          "reserved",
          "allocated",
          "version"
        ]
      },
      "Reservation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "committed",
              "released",
              "reversed",
              "expired",
              "shipped"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "warehouse_id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9-]{0,63})?$",
            "default": ""
          }
        },
        "required": [
          "id",
          "tenant_id",
          "sku",
          "quantity",
          "status",
          "version",
          "expires_at"
        ]
      },
      "ReserveOutcome": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stock": {
            "$ref": "#/components/schemas/Stock"
          },
          "reservation": {
            "$ref": "#/components/schemas/Reservation"
          }
        },
        "required": [
          "stock",
          "reservation"
        ]
      },
      "ReceiveOutcome": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stock": {
            "$ref": "#/components/schemas/Stock"
          }
        },
        "required": [
          "stock"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
